# The core demo is offline and requires no environment variables.
# Development-only data acquisition scripts use fixed public source URLs.

# Optional: enables the "Ask HeatHunter" chat and floor-plan reading.
# Copy this file to .env (git-ignored). A real environment variable wins.
# Free Gemini key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# Or use Claude instead (paid): https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# Force a provider (gemini | anthropic) and/or model; defaults pick Gemini first.
# HEATHUNTER_ASSISTANT_PROVIDER=gemini
# HEATHUNTER_ASSISTANT_MODEL=gemini-flash-latest
