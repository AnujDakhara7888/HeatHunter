# The core demo is offline and requires no environment variables.
# Development-only data acquisition scripts use fixed public source URLs.

# Optional on-site assistant (POST /api/chat). Without a key the chat panel
# shows "unavailable" and everything else works offline. Never commit a real key.
# ANTHROPIC_API_KEY=
# HEATHUNTER_CHAT_MODEL=claude-opus-5-5
# HEATHUNTER_CHAT_PER_VISITOR=15        # messages per visitor per window
# HEATHUNTER_CHAT_WINDOW_SECONDS=600
# HEATHUNTER_CHAT_DAILY_LIMIT=300       # whole-site messages per day
