# The core demo is offline and requires no environment variables.
# Development-only data acquisition scripts use fixed public source URLs.

# Optional: enables the "Ask HeatHunter" chat and floor-plan reading.
# Copy this file to .env (git-ignored) and paste your key from
# https://console.anthropic.com/settings/keys. A real environment variable wins.
# ANTHROPIC_API_KEY=sk-ant-...
# HEATHUNTER_ASSISTANT_MODEL=claude-sonnet-5-5

# To use OpenAI for home chat instead (floor-plan reading still uses Claude).
# With only OPENAI_API_KEY set, chat uses OpenAI automatically; set the provider
# explicitly when both keys are present.
# HEATHUNTER_CHAT_PROVIDER=openai
# OPENAI_API_KEY=your-api-key
# HEATHUNTER_OPENAI_MODEL=gpt-5-nano
# Create your key at https://platform.openai.com/api-keys.
# OpenAI API usage is billed separately from a ChatGPT subscription.
